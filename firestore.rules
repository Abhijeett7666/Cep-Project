rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if request is from the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if authenticated user has administrative role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // USERS COLLECTION
    // - Anyone can read public user names for display
    // - Citizens can register their own profile (strictly role == 'citizen')
    // - Users can update only their own profile
    // - Admins can read and update all user profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        // Prevent citizens from giving themselves admin role
        (request.resource.data.role == 'citizen' && request.auth.uid == userId) ||
        isAdmin()
      );
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // COMPLAINTS COLLECTION
    // - Citizens can read their own complaints
    // - Authorized Admins can read all complaints
    // - Citizens can create complaints with their own userId and valid fields
    // - Only Admins can update status, assign workers, and add admin notes
    match /complaints/{complaintId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'Pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // COMPLAINT STATUS HISTORY AUDIT LOG
    // - Citizens can read history for their own complaints
    // - Admins can read and write audit history events
    match /complaintHistory/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // SANITATION WORKERS COLLECTION
    // - Admins can manage workers
    // - Authenticated users can read worker directory
    match /workers/{workerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
